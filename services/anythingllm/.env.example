# Required: JWT signing secret. Generate with: openssl rand -hex 32
ANYTHINGLLM_JWT_SECRET=

# Optional: AnythingLLM web UI password. Leave empty to disable UI auth (dev only).
ANYTHINGLLM_UI_PASSWORD=

# Note: The API key for programmatic access is generated inside the AnythingLLM UI
# under Settings > API Keys. Set it in apps/web/.env as ANYTHINGLLM_API_KEY.
