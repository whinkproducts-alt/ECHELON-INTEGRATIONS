FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DO_NOT_TRACK=1 \
    WHISPER_MODEL_PATH=/models/whisper-small.en HF_HOME=/models/hf
WORKDIR /speech
RUN apt-get update && apt-get install --no-install-recommends -y espeak-ng && rm -rf /var/lib/apt/lists/*
COPY requirements.txt runtime-requirements.txt LICENSES.md app.py prepare_models.py ./
# The exact +cpu build avoids multi-gigabyte CUDA dependency packages on Linux.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch==2.8.0+cpu' && \
    pip install --no-cache-dir -r requirements.txt -r runtime-requirements.txt && \
    useradd --uid 10001 --create-home speech && \
    mkdir -p /models && chown speech:speech /models
USER 10001:10001
CMD ["python", "app.py"]
