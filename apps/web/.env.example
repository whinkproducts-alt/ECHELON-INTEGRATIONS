# Postgres with pgvector (local Docker)
DATABASE_URL=
# Direct (non-pooled) connection. Prisma migrate uses this. Required by schema.prisma.
# Local Docker: set it to the same value as DATABASE_URL.
# Neon: DATABASE_URL = pooled host (has -pooler in the name), DIRECT_URL = direct host (no -pooler).
# If Neon connections fail, remove channel_binding=require from the URL.
DIRECT_URL=

# Auth
NEXTAUTH_SECRET=
AUTH_SECRET=

# Model router (Phase 1). Ollama is the local default; connect a cloud plan/provider separately if desired.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
DEFAULT_MODEL=wink-qwen3.5-9b-8k
SWARM_MODEL=wink-qwen3.5-9b-8k
# Model for memory extraction and debrief. Defaults to DEFAULT_MODEL. Use a fast local model for offline operation.
EXTRACTION_MODEL=

# Embeddings (Phase 3 — pgvector).
# EMBEDDING_MODEL selects the provider and model in "provider/model" format.
# Supported: "ollama/<model>" (uses OLLAMA_URL or localhost:11434) and "openai/<model>" (uses OPENAI_API_KEY).
# Default: ollama/nomic-embed-text (768-dim, Apache 2.0, free, nothing leaves the Mac).
# Changing this requires a DB migration to resize the vector column to the new model's dimension.
EMBEDDING_MODEL=ollama/nomic-embed-text
OLLAMA_URL=http://localhost:11434
# Legacy OpenAI-compatible endpoint (overrides EMBEDDING_MODEL when set):
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=

# Voice (Phase 4). Optional — browser Web Speech API is used when these are not set.
# Cloud providers (Deepgram STT + OpenAI TTS) — fastest path, no local Docker needed:
STT_PROVIDER=deepgram              # "deepgram" | "" (empty = use STT_URL below)
DEEPGRAM_API_KEY=                  # https://console.deepgram.com — nova-3 model, ~200ms latency
DEEPGRAM_MODEL=nova-3              # nova-3 (default) | nova-2 | enhanced
TTS_PROVIDER=openai                # "openai" | "" (empty = use TTS_URL below)
TTS_MODEL=tts-1                    # tts-1 (fast) | tts-1-hd (higher quality)
TTS_VOICE=alloy                    # alloy | echo | fable | onyx | nova | shimmer
# Local/self-hosted providers (ADA V2 migration: set STT_URL and TTS_URL, clear STT_PROVIDER/TTS_PROVIDER):
STT_URL=http://localhost:8765/v1   # faster-whisper or ADA V2 STT endpoint
TTS_URL=http://localhost:8766/v1   # kokoro-fastapi or ADA V2 TTS endpoint
WHISPER_MODEL=base                 # base (fast, 74M params) | small | medium | large-v3

# ADA Voice Service (services/voice) — optional local Deepgram wrapper
# Run with: cd services/voice && docker compose up -d
ADA_VOICE_URL=http://localhost:3002
ADA_AUTH_TOKEN=

# Web search (optional — DuckDuckGo instant answers used when not set)
BRAVE_SEARCH_API_KEY=              # https://brave.com/search/api/ — free tier: 2000 queries/month

# OpenClaw — WHINK's MCP gateway (Phase 2c). Run via services/openclaw/docker-compose.yml.
# Leave OPENCLAW_URL empty to disable the gateway: no network call, no ledger noise,
# standard tools only. To enable, set it to http://localhost:3100 and set OPENCLAW_TOKEN to the
# same value as services/openclaw/.env (generate once: openssl rand -hex 32).
# If set but unreachable, chat still works and the ledger records one gateway_unavailable row per request.
OPENCLAW_URL=
# Gateway tools are owner-only until per-tenant credentials exist. Comma-separated user ids that may
# use them. Empty means nobody. This list is the only way in; a user's role grants nothing.
OPENCLAW_ALLOWED_USER_IDS=
# Default true: gateway tools not reviewed in config/tool-classes.json get a neutral description. Set false to pass sanitised upstream text.
OPENCLAW_NEUTRAL_DESCRIPTIONS=true
OPENCLAW_TOKEN=  # Shared secret for OpenClaw gateway. Generate with: openssl rand -hex 32

# AnythingLLM — document recall service (Phase 3). Run via services/anythingllm/docker-compose.yml.
# ANYTHINGLLM_URL: published on 127.0.0.1 only (see services/anythingllm/docker-compose.yml).
ANYTHINGLLM_URL=http://127.0.0.1:3001
# ANYTHINGLLM_API_KEY: the AUTH_TOKEN from services/anythingllm/.env (same value).
# Generate once: openssl rand -hex 32. Required for all API calls.
ANYTHINGLLM_API_KEY=
# JWT_SECRET: set in services/anythingllm/.env. Not needed here — WHINK uses the API key only.
ANYTHINGLLM_JWT_SECRET=
# ANYTHINGLLM_WORKSPACE_SLUG is removed — workspace slugs are now per-user in document_workspaces table.
# Maximum document upload size in MB. Files over this limit are rejected at the API boundary.
DOCUMENT_MAX_SIZE_MB=25

# Auto memory extraction (Phase 3b).
# Per-user daily write cap for auto-extracted memories. Over the cap, extraction is skipped for the
# rest of that day and one memory_cap_reached ledger row is written (never one per skipped turn).
MEMORY_DAILY_CAP=200

# 64 hex chars (openssl rand -hex 32). Encrypts BYOK API keys and social OAuth tokens. Required.
# Required: 64 hex chars (openssl rand -hex 32). No fallback key exists; without it BYOK keys and social connections return 503.
ENCRYPTION_KEY=""
# Optional JSON overrides for per-user daily social write caps (defaults posts 25, replies 50, dms 20, follows 10, deletes 20).
SOCIAL_DAILY_CAPS=""

# Social connections (Phase 2d). OAuth client credentials for each platform, from its developer portal.
# Leave empty to disable that platform: connect returns platform_not_configured.
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public origin of this app, for example https://whink.example.com (no path). The callback URL is
# <base>/api/social/<platform>/callback and must be registered with the platform.
SOCIAL_OAUTH_REDIRECT_BASE=
# Comma-separated exact callback URLs that may be used as redirect_uri. Anything else is rejected.
SOCIAL_OAUTH_REDIRECT_ALLOWLIST=

# Daily SMS briefing (CSA Phase 2). Off unless BRIEFING_SMS_ENABLED=true. See docs/TWILIO_SETUP.md.
# Put real values in .env.local, never in this file.
BRIEFING_SMS_ENABLED=false
BRIEFING_USER_ID=            # id of the WHINK user whose ledger records each SMS
BRIEFING_SMS_TO=             # recipient in E.164, for example +14035550123
BRIEFING_SEND_TIME=16:15     # HH:MM in BRIEFING_TZ
BRIEFING_TZ=America/Edmonton # IANA zone. Confirm with Victor, see docs/TWILIO_SETUP.md
BRIEFING_START_DATE=2026-10-18
BRIEFING_END_DATE=2026-11-19
BRIEFING_REPORTS_DIR=        # folder of directorate report JSON files
TWILIO_ACCOUNT_SID=          # starts with AC
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # your Twilio number in E.164
TWILIO_MESSAGING_SERVICE_SID= # optional; when set it is used instead of TWILIO_FROM_NUMBER
TWILIO_WHATSAPP_FROM=        # WhatsApp-enabled Twilio number, e.g. whatsapp:+14155238886

# Gesture pipeline (Stream 3). 64 hex chars (openssl rand -hex 32). Derives per session HMAC signing keys.
# Required for /api/gesture; without it the routes return 503. Never reuse ENCRYPTION_KEY.
GESTURE_HMAC_SECRET=""

# Communications — Telegram
TELEGRAM_BOT_TOKEN=

# Communications — SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Operator, security and usage settings (added 2026-10-25) ---
# Comma-separated owner emails (exact, case-insensitive). Only these accounts see the board roster and
# which operator credentials (SMTP, Twilio, gateway) are configured. Unset means nobody is an owner.
WHINK_OWNER_EMAILS=
# Number of trusted reverse proxies in front of the app. Only then is X-Forwarded-For used for rate
# limits (the Nth address from the right). Leave empty when not behind a proxy you control.
TRUSTED_PROXY_HOPS=
# Cloud-to-local fallback. Default off. Requires OLLAMA_URL to be a local address.
WHINK_OFFLINE_FALLBACK=
WHINK_LOCAL_MODEL=wink-qwen3.5-9b-8k
# Tenant monthly token cap per user (0 or empty = no cap). A user cannot raise or remove it.
WHINK_MONTHLY_TOKEN_BUDGET=
WHINK_BUDGET_SOFT_PCT=
WHINK_BUDGET_HARD_PCT=
# Optional JSON of USD per 1M tokens, for cost estimates, e.g. {"claude":{"in":0,"out":0}}. Empty = cost 0.
WHINK_MODEL_PRICES=

# Passkeys / Touch ID (WebAuthn). RP ID is the bare domain; ORIGIN is the exact browser origin(s), comma separated.
# Localhost: WEBAUTHN_RP_ID=localhost  WEBAUTHN_ORIGIN=http://localhost:3000
# Mac Mini over HTTPS: WEBAUTHN_RP_ID=whink.example.com  WEBAUTHN_ORIGIN=https://whink.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# POST /api/signup is open only when this is exactly "true", or while the users table is empty
# (first-user bootstrap). "false" closes it outright. Register the owner first, then leave it
# empty or false. WHINK_OWNER_EMAILS matches the owner by email, so never leave signup open. See docs/security.md.
SIGNUP_ENABLED=
# memory | postgres. Rate-limit counter store. Empty: postgres when DATABASE_URL is set.
RATE_LIMIT_STORE=

# Change requests: Submit creates a GitHub issue ONLY after the owner approves that request id. Fine-grained token, issues:write only.
CHANGE_REQUEST_GITHUB_REPO=
CHANGE_REQUEST_GITHUB_TOKEN=
# Who the issue asks to build it (default @claude). Optional model override for refining.
CHANGE_REQUEST_BUILD_MENTION=
CHANGE_REQUEST_MODEL=
# Self-hosted meeting provider (for example Jitsi Meet). https, or http on localhost only. Empty = no rooms, no outside calls.
MEETING_PROVIDER_BASE_URL=
# Standing roster worker (pnpm worker). Off unless WORKER_ENABLED=true.
WORKER_ENABLED=
WORKER_CONCURRENCY=
# Optional: per-job timeout in ms (default 120000) and model per tier (empty = router default).
WORKER_JOB_TIMEOUT_MS=
WORKER_MODEL_FAST=
WORKER_MODEL_STANDARD=
WORKER_MODEL_DEEP=

# Skill uploads store raw skill text only when ENCRYPTION_KEY is set. Set to true ONLY to allow plain text storage (dev).
SKILL_ALLOW_PLAINTEXT=""
# Model for the skill security agent and committee (falls back to DEFAULT_MODEL).
SKILL_PIPELINE_MODEL=""

# Fresh-install protection. When set, the FIRST account must send this value as `bootstrapToken` in the
# signup body. Empty: the first visitor to reach an empty instance can register as the owner. Set it
# before exposing a new instance, then remove it once the owner exists.
SIGNUP_BOOTSTRAP_TOKEN=
# Models a signed-in user may request in chat (comma separated). Empty: the model picker's list plus DEFAULT_MODEL
# and WHINK_LOCAL_MODEL. A user who stored their own key for a provider may use any model of that provider.
# Anything else falls back to DEFAULT_MODEL and is ledgered as model_not_allowed.
WHINK_ALLOWED_MODELS=

