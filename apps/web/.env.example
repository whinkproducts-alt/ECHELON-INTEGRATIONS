# Postgres with pgvector (local Docker)
DATABASE_URL=

# Auth
NEXTAUTH_SECRET=
AUTH_SECRET=

# Model router (Phase 1). Fill only the providers you use.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
DEFAULT_MODEL=claude-sonnet-4-6
# Model for memory extraction and debrief. Defaults to DEFAULT_MODEL. Use a fast local model for offline operation.
EXTRACTION_MODEL=

# Embeddings (Phase 3 — pgvector). Optional.
# If EMBEDDINGS_URL is set, that OpenAI-compatible endpoint is used with EMBEDDINGS_MODEL.
# If only OPENAI_API_KEY is set, OpenAI text-embedding-3-small is used automatically.
# If neither is set, Ollama at localhost:11434 with nomic-embed-text is used.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=

# Voice (Phase 4). Optional — browser Web Speech API is used when these are not set.
# Cloud providers (Deepgram STT + OpenAI TTS) — fastest path, no local Docker needed:
STT_PROVIDER=deepgram              # "deepgram" | "" (empty = use STT_URL below)
DEEPGRAM_API_KEY=                  # https://console.deepgram.com — nova-3 model, ~200ms latency
DEEPGRAM_MODEL=nova-3              # nova-3 (default) | nova-2 | enhanced
TTS_PROVIDER=openai                # "openai" | "" (empty = use TTS_URL below)
TTS_MODEL=tts-1                    # tts-1 (fast) | tts-1-hd (higher quality)
TTS_VOICE=alloy                    # alloy | echo | fable | onyx | nova | shimmer
# Local/self-hosted providers (ADA V2 migration: set STT_URL and TTS_URL, clear STT_PROVIDER/TTS_PROVIDER):
STT_URL=http://localhost:8765/v1   # faster-whisper or ADA V2 STT endpoint
TTS_URL=http://localhost:8766/v1   # kokoro-fastapi or ADA V2 TTS endpoint
WHISPER_MODEL=base                 # base (fast, 74M params) | small | medium | large-v3

# Web search (optional — DuckDuckGo instant answers used when not set)
BRAVE_SEARCH_API_KEY=              # https://brave.com/search/api/ — free tier: 2000 queries/month

# OpenClaw — WHINK's MCP gateway (Phase 2c). Run via services/openclaw/docker-compose.yml.
# Leave OPENCLAW_URL empty to disable the gateway: no network call, no ledger noise,
# standard tools only. To enable, set it to http://localhost:3100 and set OPENCLAW_TOKEN to the
# same value as services/openclaw/.env (generate once: openssl rand -hex 32).
# If set but unreachable, chat still works and the ledger records one gateway_unavailable row per request.
OPENCLAW_URL=
# Gateway tools are owner-only until per-tenant credentials exist. Comma-separated user ids that may
# use them. Empty means nobody (users whose stored role is 'owner' are also allowed).
OPENCLAW_ALLOWED_USER_IDS=
# Default true: gateway tools not reviewed in config/tool-classes.json get a neutral description. Set false to pass sanitised upstream text.
OPENCLAW_NEUTRAL_DESCRIPTIONS=true
OPENCLAW_TOKEN=  # Shared secret for OpenClaw gateway. Generate with: openssl rand -hex 32

# AnythingLLM — document recall service (Phase 3). Run via services/anythingllm/docker-compose.yml.
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_JWT_SECRET=
